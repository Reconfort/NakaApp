# ServerOS control plane — environment.
#
# Copy to `.env` and fill in. Every variable below is read once at startup by
# src/config/env.logic.ts; a missing or unusable value stops the process with a
# named error rather than failing later at the first request.
#
# `.env` is git-ignored. Do not commit it, and do not put real secrets in this
# example file.

# --- Runtime -----------------------------------------------------------------

# development | test | production. Anything else is rejected.
NODE_ENV=development

# HTTP port. 1-65535.
PORT=3000

# debug | info | warn | error.
LOG_LEVEL=info

# Set to exactly "true" only when a reverse proxy you control sits in front of
# this process. It makes Express honour X-Forwarded-For, which decides what
# address lands in the audit log — so trusting it without a proxy lets any
# client forge its own IP.
TRUST_PROXY=false

# --- Database ----------------------------------------------------------------

# Postgres connection string. Must start with postgres:// or postgresql://.
# Matches the docker-compose.yml service in this directory.
DATABASE_URL=postgresql://serveros:serveros@localhost:5432/serveros?schema=public

# Only needed for `prisma migrate diff --shadow-database-url`, which is how the
# hand-written initial migration should be verified. Any empty database will do.
# SHADOW_DATABASE_URL=postgresql://serveros:serveros@localhost:5432/serveros_shadow

# --- Redis -------------------------------------------------------------------

# Used for event fan-out across instances. redis:// or rediss:// for TLS.
REDIS_URL=redis://localhost:6379

# --- Secrets -----------------------------------------------------------------
#
# Both must be at least 32 bytes and must differ from each other. Generate with:
#   openssl rand -base64 48
#
# A value starting with "change-me", "secret", "password", "example" or
# "placeholder" is rejected at startup, so a copied example cannot reach
# production by accident.

# Signs access tokens (HS256, 15-minute lifetime).
JWT_SECRET=

# Signs activity-feed pagination cursors. A separate key from JWT_SECRET on
# purpose: different lifetimes, different blast radius, independent rotation.
CURSOR_SECRET=

# --- Token claims ------------------------------------------------------------

# The `iss` claim. Verified on every request.
JWT_ISSUER=serveros-control-plane

# The `aud` claim. Change this when the iOS client gets its own audience.
JWT_AUDIENCE=serveros-app

# --- CORS --------------------------------------------------------------------

# Comma-separated origins. Leave empty for the normal case: the macOS client is
# not a browser and needs no CORS headers, so none are sent.
CORS_ORIGINS=
