{
  "name": "@serveros/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "ServerOS control plane — identity, server registry, enrollment, projects, activity and events.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
